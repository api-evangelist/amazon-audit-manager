              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates an assessment report for the specified assessment in AWS Audit Manager."
        },
        {
          "info": {
            "name": "Amazon Audit Manager List Assessment Reports",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://auditmanager.us-east-1.amazonaws.com/assessmentReports",
            "params": [
              {
                "name": "maxResults",
                "value": "",
                "type": "query"
              },
              {
                "name": "nextToken",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a list of assessment reports created in AWS Audit Manager."
